<UserControl x:Class="Leitor.Presentation.LibraryPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:Leitor.Presentation">
 <UserControl.Resources>
  <BitmapImage x:Key="StudyRoomImage" UriSource="/Leitor;component/Assets/StudyRoom.jpg"/>
  <ImageBrush x:Key="StudyShelfArtwork" ImageSource="{StaticResource StudyRoomImage}"
   Viewbox="0,0,1,0.50" ViewboxUnits="RelativeToBoundingBox" Stretch="UniformToFill" AlignmentY="Bottom"/>
  <ImageBrush x:Key="StudyDeskArtwork" ImageSource="{StaticResource StudyRoomImage}"
   Viewbox="0,0.56,1,0.44" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill"/>
  <p:FolderPalette x:Key="FolderPalette"/><p:LibraryTileWidth x:Key="TileWidth"/>
  <Style x:Key="LibraryIcon" TargetType="p:AppIcon">
   <Setter Property="Foreground">
    <Setter.Value>
     <MultiBinding Converter="{StaticResource FolderPalette}">
      <Binding Path="Visual"/>
      <Binding Path="DataContext.Settings.Dark" RelativeSource="{RelativeSource AncestorType=p:LibraryPanel}"/>
     </MultiBinding>
    </Setter.Value>
   </Setter>
   <Style.Triggers>
    <DataTrigger Binding="{Binding Visual}" Value="{x:Null}"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="280" MinWidth="200" MaxWidth="520"/><ColumnDefinition x:Name="SidebarGap" Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border x:Name="FolderSidebar" Style="{StaticResource Card}" Background="{DynamicResource StudyPanelBrush}"
   Padding="0" SizeChanged="SidebarSizeChanged">
   <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
     <Border x:Name="StudyHeader" Height="106" CornerRadius="15,15,0,0"
      Background="{StaticResource StudyShelfArtwork}" IsHitTestVisible="False"/>
     <Button x:Name="SidebarHome" DataContext="{Binding Breadcrumbs[0]}" Click="NavigateCrumb" AllowDrop="True"
       DragOver="DragOverFolder" Drop="DropCrumb" Style="{StaticResource QuietButton}" AutomationProperties.Name="Raiz da biblioteca"
       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
      <StackPanel Orientation="Horizontal">
       <p:AppIcon Kind="Book" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
        Width="23" Height="23" Margin="0,0,8,0"/>
       <StackPanel>
        <TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="StudySubtitle" Text="Seu espaço de estudos" FontSize="11" Margin="0,2,0,0"/>
       </StackPanel>
      </StackPanel>
     </Button>
    </Grid>
    <Border x:Name="StudyIllustration" DockPanel.Dock="Bottom" Height="96" CornerRadius="0,0,15,15" Margin="0,8,0,0"
      Background="{StaticResource StudyDeskArtwork}" IsHitTestVisible="False"/>
    <ListBox x:Name="FolderTree" ItemsSource="{Binding FolderRows}" SelectedItem="{Binding SelectedFolder}" Margin="10,0"
     AutomationProperties.Name="Árvore de pastas" GotKeyboardFocus="TreeFocus" PreviewKeyDown="FolderKey" PreviewMouseRightButtonDown="SelectContext"
     PreviewMouseLeftButtonDown="BeginDrag" MouseMove="DragItem" AllowDrop="True" DragOver="DragOverFolder" Drop="DropFolder"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ContextMenu><ContextMenu Opened="TreeMenuOpened"/></ListBox.ContextMenu>
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
       <Setter Property="Padding" Value="7,6"/>
       <Setter Property="Margin" Value="0,0,0,7"/>
       <Setter Property="Template">
        <Setter.Value>
         <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="FolderCard" Background="{DynamicResource StudyFolderBrush}" BorderBrush="Transparent"
           BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
           <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FolderCard" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
           <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="FolderCard" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            <Setter TargetName="FolderCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
           </Trigger>
           <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FolderCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          </ControlTemplate.Triggers>
         </ControlTemplate>
        </Setter.Value>
       </Setter>
       <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <DockPanel Margin="{Binding Indent}" LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="{Binding Expander}" Click="ExpandFolder" IsEnabled="{Binding HasChildren}" Style="{StaticResource QuietButton}"
         AutomationProperties.Name="{Binding ExpansionLabel}" Padding="2" MinWidth="21" MinHeight="26" Margin="0"/>
        <Border Width="36" Height="36" CornerRadius="9" Margin="0,0,10,0">
         <Border.Background>
          <MultiBinding Converter="{StaticResource FolderPalette}" ConverterParameter="badge">
           <Binding Path="Visual"/>
           <Binding Path="DataContext.Settings.Dark" RelativeSource="{RelativeSource AncestorType=p:LibraryPanel}"/>
          </MultiBinding>
         </Border.Background>
         <p:AppIcon Kind="{Binding Icon}" Style="{StaticResource LibraryIcon}" Width="23" Height="23"/>
        </Border>
        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Label}">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Count, StringFormat={}{0} texto(s)}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
       </DockPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>
  <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
   ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" DragCompleted="LibraryResized" Focusable="True"
   AutomationProperties.Name="Largura da árvore de pastas" Background="Transparent"/>
  <Grid Grid.Column="2">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="SidebarToggle" Click="ToggleSidebar" Style="{StaticResource IconButton}" AutomationProperties.Name="Recolher painel de pastas" ToolTip="Recolher painel de pastas"><p:AppIcon Kind="Sidebar"/></Button>
    <Button Command="{Binding NavigateBackCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Voltar" ToolTip="Voltar · Alt+←"><p:AppIcon Kind="Left"/></Button>
    <Button Command="{Binding NavigateForwardCommand}" Style="{StaticResource IconButton}" AutomationProperties.Name="Avançar" ToolTip="Avançar · Alt+→"><p:AppIcon Kind="Right"/></Button>
   </StackPanel>
   <Grid DockPanel.Dock="Right" Width="210" Margin="12,0,0,0">
    <TextBox x:Name="SearchBox" Margin="0" Padding="10,7"
     Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar na biblioteca · Ctrl+F"
     AutomationProperties.Name="Pesquisar nomes de pastas, títulos ou conteúdo"/>
    <TextBlock Text="Pesquisar na biblioteca" Margin="12,0,0,0" VerticalAlignment="Center"
     IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
     <TextBlock.Style>
      <Style TargetType="TextBlock">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
      </Style>
     </TextBlock.Style>
    </TextBlock>
   </Grid>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <StackPanel Orientation="Horizontal"><TextBlock Text="›" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Id}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="{Binding Name}" Click="NavigateCrumb" AllowDrop="True" DragOver="DragOverFolder"
        Drop="DropCrumb" Padding="9,6" Margin="0,0,4,0" MaxWidth="235" ToolTip="{Binding Name}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding Current}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></Button.Style>
        <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/></DataTemplate></Button.ContentTemplate>
       </Button></StackPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </DockPanel>
  <TextBlock Grid.Row="1" Text="{Binding DirectoryTitle}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
   MaxHeight="92" ToolTip="{Binding DirectoryTitle}" Margin="1,1,0,10"/>
  <DockPanel Grid.Row="2" Margin="0,0,0,10">
   <Button DockPanel.Dock="Left" Content="Nova pasta" Command="{Binding NewFolderCommand}" ToolTip="{Binding NewFolderLocation}"/>
   <Grid DockPanel.Dock="Right" Margin="5,0,0,0"><Button x:Name="OptionsButton" Content="Opções" Click="ToggleOptions" Style="{StaticResource QuietButton}"/><Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom" StaysOpen="False" PreviewKeyDown="OptionsKey"><Border Style="{StaticResource Card}" Padding="12" Width="255"><ScrollViewer MaxHeight="370" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="6,0,0,4">
     <Expander Header="Filtros e ordenação">
      <StackPanel Margin="0,6,0,0">
       <ComboBox ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding LibraryScope}" AutomationProperties.Name="Escopo da pesquisa"/>
       <TextBox Text="{Binding TagFilter,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar por etiqueta" ToolTip="Filtrar por etiqueta exata"/>
       <ComboBox ItemsSource="{Binding LibrarySorts}" SelectedItem="{Binding LibrarySort}" AutomationProperties.Name="Ordenação dos documentos"/>
       <Button Command="{Binding ClearFilterCommand}" Content="Limpar filtros"/>
      </StackPanel>
     </Expander>
     <Expander Header="Aparência da biblioteca">
      <StackPanel Margin="0,6,0,0">
       <CheckBox Content="Exibir em grade" IsChecked="{Binding LibraryGrid}"/>
       <ComboBox ItemsSource="{Binding Densities}" SelectedItem="{Binding LibraryDensity}" AutomationProperties.Name="Densidade visual"/>
       <Slider Minimum="16" Maximum="40" TickFrequency="2" IsSnapToTickEnabled="True"
        Value="{Binding LibraryIconSize}" AutomationProperties.Name="Tamanho dos ícones" ToolTip="Tamanho dos ícones"/>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer></Border></Popup></Grid>
   <ComboBox Width="172" HorizontalAlignment="Left" VerticalAlignment="Top" ItemsSource="{Binding LibraryViews}" SelectedItem="{Binding LibraryView}" Margin="0"
     AutomationProperties.Name="Exibir na biblioteca"/>
  </DockPanel>
  <Border Grid.Row="3" Padding="0">
   <Grid>
    <ListBox x:Name="LibraryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
     MouseDoubleClick="OpenEntry" GotKeyboardFocus="EntryFocus" PreviewKeyDown="EntryKey" PreviewMouseRightButtonDown="SelectContext"
     PreviewMouseLeftButtonDown="BeginDrag" MouseMove="DragItem" AllowDrop="True" DragOver="DragOverFolder" Drop="DropFolder"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pastas e documentos">
     <ListBox.Style>
      <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
       <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding LibraryGrid}" Value="True">
         <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
         <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource TileWidth}}"/></ItemsPanelTemplate></Setter.Value></Setter>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </ListBox.Style>
     <ListBox.ContextMenu><ContextMenu Opened="EntryMenuOpened"/></ListBox.ContextMenu>
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
       <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
       <Setter Property="Padding" Value="{Binding DataContext.EntryPadding, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
       <Setter Property="Margin" Value="0,0,4,3"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding DataContext.LibraryGrid,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                  <Setter Property="Margin" Value="0,0,10,10"/>
         <Setter Property="Template">
          <Setter.Value>
           <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
             BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}" MinHeight="94">
             <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
             <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
             <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
             <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
           </ControlTemplate>
          </Setter.Value>
         </Setter>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Grid ToolTip="{Binding Tooltip}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center">
         <Border.Style>
          <Style TargetType="Border">
           <Setter Property="Padding" Value="4"/>
           <Setter Property="Background">
            <Setter.Value>
             <MultiBinding Converter="{StaticResource FolderPalette}" ConverterParameter="badge">
              <Binding Path="Visual"/>
              <Binding Path="DataContext.Settings.Dark" RelativeSource="{RelativeSource AncestorType=p:LibraryPanel}"/>
             </MultiBinding>
            </Setter.Value>
           </Setter>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Visual}" Value="{x:Null}"><Setter Property="Padding" Value="0"/></DataTrigger>
           </Style.Triggers>
          </Style>
         </Border.Style>
         <p:AppIcon Kind="{Binding Icon}" Style="{StaticResource LibraryIcon}"
           Width="{Binding DataContext.LibraryIconSize,RelativeSource={RelativeSource AncestorType=ListBox}}"
           Height="{Binding Width, RelativeSource={RelativeSource Self}}"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
         <TextBlock Text="{Binding Name}" FontSize="15" LineHeight="20" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Name}"/>
         <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="Nenhuma pasta ou documento para exibir." Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
     TextWrapping="Wrap" Visibility="{Binding ExplorerEmpty, Converter={StaticResource BoolVisibility}}"/>
   </Grid>
  </Border>
  <DockPanel Grid.Row="4" Margin="0,10,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding HasMultiplePages, Converter={StaticResource BoolVisibility}}">
    <Button Content="‹" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="Página anterior" Padding="7,3"/>
    <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="8,0,12,0"/>
    <Button Content="›" Command="{Binding NextPageCommand}" AutomationProperties.Name="Próxima página" Padding="7,3"/>
   </StackPanel>
   <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Center" Margin="0,0,16,0"
    Visibility="{Binding LibraryBusy,Converter={StaticResource BoolVisibility}}"/>
  </DockPanel>
  </Grid>
 </Grid>
</UserControl>
