<UserControl x:Class="Leitor.Presentation.LibraryPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Leitor.Presentation">
 <Border Style="{StaticResource Card}" Padding="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Grid><TextBlock Text="Biblioteca" FontSize="18" FontWeight="SemiBold"/><Button HorizontalAlignment="Right" Command="{Binding NewFolderCommand}" Style="{StaticResource IconButton}" ToolTip="Nova pasta · Ctrl+Shift+N" AutomationProperties.Name="Criar pasta"><p:AppIcon Kind="Folder"/></Button></Grid>
    <ComboBox ItemsSource="{Binding LibraryViews}" SelectedItem="{Binding LibraryView}" Margin="0,4" Padding="8,6" MinHeight="32" AutomationProperties.Name="Visualização da biblioteca"/>
    <TextBlock Text="{Binding FolderBreadcrumb}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderBreadcrumb}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4"/>
    <ListBox x:Name="FolderTree" GotKeyboardFocus="LibraryFocus" ItemsSource="{Binding FolderRows}" SelectedItem="{Binding SelectedFolder}" Height="145" Visibility="{Binding ShowFolders, Converter={StaticResource BoolVisibility}}" ToolTip="Contagens incluem subpastas. Textos protegidos só contam na sessão desbloqueada." AutomationProperties.Name="Pastas e subpastas" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="FolderKey" PreviewMouseRightButtonDown="SelectContext" AllowDrop="True" DragOver="DragOverFolder" Drop="DropFolder" PreviewMouseLeftButtonDown="BeginDrag" MouseMove="DragItem">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/><Setter Property="Padding" Value="3,5"/><Setter Property="Margin" Value="0"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ContextMenu><ContextMenu Opened="FolderMenuOpened"/></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding Indent}"><Button Content="{Binding Expander}" Click="ExpandFolder" Padding="2" MinWidth="20" MinHeight="24" Margin="0,0,3,0" ToolTip="Expandir ou recolher pasta" AutomationProperties.Name="{Binding ExpansionLabel}" IsEnabled="{Binding HasChildren}"/><p:AppIcon Kind="{Binding Icon}" Width="15" Height="15" Margin="0,0,6,0"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox><TextBlock Text="Ainda sem pastas · use Nova pasta" FontSize="11" TextWrapping="Wrap" Visibility="{Binding NoFolders, Converter={StaticResource BoolVisibility}}"/>
   </StackPanel>
   <StackPanel Grid.Row="1"><TextBox x:Name="SearchBox" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar título ou conteúdo" ToolTip="Pesquisar · Ctrl+F" Margin="0,8,0,4" Padding="8,6"/>
    <Expander Header="Filtros e ordenação" Margin="0,4,0,8"><StackPanel><ComboBox ItemsSource="{Binding SearchScopes}" SelectedItem="{Binding LibraryScope}" AutomationProperties.Name="Escopo da pesquisa"/><TextBox Text="{Binding TagFilter,UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtrar por etiqueta exata" AutomationProperties.Name="Etiqueta"/><ComboBox ItemsSource="{Binding LibrarySorts}" SelectedItem="{Binding LibrarySort}" AutomationProperties.Name="Ordenar documentos"/></StackPanel></Expander>
   </StackPanel>
   <Grid Grid.Row="2"><ListBox x:Name="LibraryList" GotKeyboardFocus="LibraryFocus" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" MouseDoubleClick="OpenDocument" PreviewMouseRightButtonDown="SelectContext" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Textos da biblioteca" PreviewMouseLeftButtonDown="BeginDrag" MouseMove="DragItem">
    <ListBox.ContextMenu><ContextMenu Opened="DocumentMenuOpened"/></ListBox.ContextMenu>
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,0,0,3"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><StackPanel><DockPanel><p:AppIcon Kind="Book" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding Tags}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding Location}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/><TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,6"/><ProgressBar Value="{Binding ProgressValue,Mode=OneWay}" Height="3" Maximum="100" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding ProgressLabel}" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="{Binding ProtectionStatus}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox><StackPanel Visibility="{Binding LibraryEmpty,Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="8"><TextBlock Text="Pasta vazia ou nenhum resultado" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Crie um texto, mova documentos ou ajuste os filtros." FontSize="12" TextWrapping="Wrap" Margin="0,8"/><Button Content="Limpar filtros" Command="{Binding ClearFilterCommand}"/></StackPanel></Grid>
   <StackPanel Grid.Row="3" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="‹" Command="{Binding PreviousPageCommand}" ToolTip="Página anterior" Padding="8,4" MinHeight="28"/><TextBlock Grid.Column="1" Text="{Binding PageLabel}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/><Button Grid.Column="2" Content="›" Command="{Binding NextPageCommand}" ToolTip="Próxima página" Padding="8,4" MinHeight="28"/></Grid><Button Content="Minha biblioteca · sem pasta" Click="RootDropClick" AllowDrop="True" DragOver="DragOverFolder" Drop="DropRoot" FontSize="10" Padding="5" MinHeight="28" ToolTip="Destino principal para arrastar documentos ou pastas"/><Button Content="Abrir selecionado" Command="{Binding OpenCommand}" Margin="0,4,0,0" Padding="5,7"/><ProgressBar IsIndeterminate="True" Height="2" Visibility="{Binding LibraryBusy,Converter={StaticResource BoolVisibility}}" Margin="0,5,0,0"/></StackPanel>
  </Grid>
 </Border>
</UserControl>